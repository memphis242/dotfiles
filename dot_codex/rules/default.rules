prefix_rule(pattern=["python3", "dojo_server.py"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "curl --fail --silent --show-error http://127.0.0.1:8765/api/health && curl --fail --silent --show-error http://127.0.0.1:8765/api/dashboard | python3 -m json.tool | sed -n '1,80p' && curl --fail --silent --show-error http://127.0.0.1:8765/ | sed -n '1,24p' && curl --fail --silent --show-error http://127.0.0.1:8765/app.js >/dev/null && curl --fail --silent --show-error http://127.0.0.1:8765/styles.css >/dev/null"], decision="allow")
prefix_rule(pattern=["firefox", "--headless"], decision="allow")
prefix_rule(pattern=["mkdir", "-p", "/tmp/rust-dojo-firefox-profile-20260817"], decision="allow")
prefix_rule(pattern=["python3", "-m", "unittest"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "BETTERFLASH_BUILD_DIR=/tmp/betterflash-sync-build scripts/build-desktop.sh -DBUILD_TESTING=ON"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "QT_QPA_PLATFORM=offscreen /tmp/betterflash-sync-build/integration_test offlineContentAndReviewConvergeInEitherUploadOrder concurrentReviewUploadsConvergeAndRetainIndependentVariants changedInfoIdentityPreventsUploads"], decision="allow")
prefix_rule(pattern=["systemd-analyze", "verify", "server/deploy/betterflash-sync.service"], decision="allow")
prefix_rule(pattern=["python3", "-W", "error::ResourceWarning", "-m", "unittest", "discover", "-s", "server/tests"], decision="allow")

# Forced/recursive deletion. The justification is what the agent sees on rejection:
# it must stop and report, never re-attempt the deletion through another tool.
prefix_rule(pattern=["rm", ["-f", "-r", "-rf", "-fr", "-R", "-Rf", "-fR", "--force", "--recursive"]], decision="forbidden", justification="Forced/recursive deletion is blocked by policy. Do NOT perform this deletion any other way (python, find -delete, unlink, mv, perl, etc.). Leave the file in place, stop this line of work, and report the exact command and this message in your final report.")
